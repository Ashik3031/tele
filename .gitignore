# Root .gitignore for TSPL Corp Project

# Node modules (if any at root)
node_modules/
package-lock.json
yarn.lock

# Environment variables
.env
.env.local
.env.*.local

# IDE and Editor
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
.DS_Store

# OS
Thumbs.db
.AppleDouble
.LSOverride

# Logs
logs/
*.log

# Coverage
coverage/

# Temporary files
*.tmp
*.temp
.tmp/

# Build artifacts (if any)
build/
dist/

# IDE specific
*.code-workspace

